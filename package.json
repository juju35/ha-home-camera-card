{
  "name": "ha-home-camera-card",
  "version": "3.5.0",
  "description": "Lovelace card for Home Assistant showing every home camera in one grid, with privacy toggles, HD/SD switching and PTZ.",
  "private": true,
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/juju35/ha-home-camera-card.git"
  },
  "author": "Julien Stéphan (https://github.com/juju35)",
  "scripts": {
    "build": "node scripts/build.mjs",
    "check": "node scripts/build.mjs && node --check dist/home-camera-card.js",
    "screenshots": "node scripts/screenshots.mjs",
    "test": "node --test \"test/*.test.mjs\"",
    "test:browser": "node scripts/build.mjs && node --test \"test/browser/*.test.mjs\""
  },
  "license": "MIT",
  "devDependencies": {
    "@mdi/js": "^7.4.47",
    "playwright": "^1.56.1"
  }
}
